	source = egl-gbm::git+https://github.com/NVIDIA/egl-gbm.git#commit=012b356ddb47d1f5203fc68c55b10eb2e23d1dfb
	sha256sums = SKIP

pkgname = lib32-egl-gbm
	pkgdesc = 32-bit NVIDIA EGL GBM external platform for Steam Wayland capture
