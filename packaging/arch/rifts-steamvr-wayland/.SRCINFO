	depends = lib32-libdrm
	depends = lib32-mesa

pkgname = rifts-steamvr-wayland
	pkgdesc = Native Wayland desktop capture dependencies for the Rift S SteamVR launcher
	depends = monado-rifts-git
	depends = steam
	depends = pipewire
	depends = xdg-desktop-portal
	depends = lib32-egl-gbm
