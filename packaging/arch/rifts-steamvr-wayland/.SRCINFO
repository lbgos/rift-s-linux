pkgbase = rifts-steamvr-wayland
	pkgver = 1.1.4
	pkgrel = 1
	url = https://github.com/NVIDIA/egl-gbm
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = meson
	makedepends = ninja
	makedepends = gcc
	makedepends = lib32-libdrm
	makedepends = lib32-mesa
