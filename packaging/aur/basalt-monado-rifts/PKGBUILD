prepare() {
  cd basalt
  # Only the shared-library dependencies are needed. Use makepkg's pinned sources
  # instead of fetching unrelated ROS/Pangolin/test submodules during prepare.
  local module
  for module in CLI11 basalt-headers opengv magic_enum; do
    git submodule init "thirdparty/$module"
    git config "submodule.thirdparty/$module.url" "$srcdir/$module"
  done
  git -c protocol.file.allow=always submodule update --no-fetch thirdparty/{CLI11,basalt-headers,opengv,magic_enum}
  cd thirdparty/basalt-headers
  for module in Sophus cereal; do
    git submodule init "thirdparty/$module"
    git config "submodule.thirdparty/$module.url" "$srcdir/$module"
  done
  git -c protocol.file.allow=always submodule update --no-fetch thirdparty/{Sophus,cereal}
  cd ../..
  local patchfile
  for patchfile in "$srcdir"/000*.patch; do patch -Np1 -i "$patchfile"; done
}

build() {
  cmake -S basalt -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTS=OFF -DBUILD_TESTING=OFF \
    -DBASALT_INSTANTIATIONS_DOUBLE=OFF -DBASALT_BUILTIN_EIGEN=OFF \
    -DEIGEN_ROOT=/usr/include/eigen3 -DBASALT_BUILD_SHARED_LIBRARY_ONLY=ON \
    -DBASALT_ENABLE_ROSBAG2=OFF -DBASALT_BUILD_VISUALIZATION=OFF \
    -DCXX_MARCH=x86-64 -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  cmake --build build --parallel 1
}

check() {
  # Reconnect requires this capability; an unpatched Basalt build is insufficient.
  nm -D build/libbasalt.so | grep -Eq ' T vit_tracker_supports_safe_recreation(@|$)'
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 basalt/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  local item
  for item in thirdparty/basalt-headers/LICENSE \
              thirdparty/basalt-headers/thirdparty/Sophus/LICENSE.txt \
              thirdparty/basalt-headers/thirdparty/cereal/LICENSE \
              thirdparty/CLI11/LICENSE thirdparty/magic_enum/LICENSE \
              thirdparty/basalt-headers/thirdparty/cereal/include/cereal/external/LICENSE \
              thirdparty/basalt-headers/thirdparty/cereal/include/cereal/external/rapidxml/license.txt \
              thirdparty/basalt-headers/thirdparty/cereal/include/cereal/external/rapidjson/LICENSE \
              thirdparty/basalt-headers/thirdparty/cereal/include/cereal/external/rapidjson/msinttypes/LICENSE \
              thirdparty/opengv/License.txt thirdparty/vit/LICENSE; do
    install -Dm644 "basalt/$item" "$pkgdir/usr/share/licenses/$pkgname/$item"
  done
  # The amalgamated header contains the JSON library and embedded-code notices.
  install -Dm644 basalt/thirdparty/json/nlohmann/json.hpp \
    "$pkgdir/usr/share/licenses/$pkgname/json-source-notices.hpp"
}
