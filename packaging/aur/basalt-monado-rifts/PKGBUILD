license=('BSD-2-Clause' 'BSD-3-Clause' 'MIT' 'BSL-1.0')
depends=('glibc' 'libgcc' 'libstdc++' 'opencv' 'onetbb' 'fmt')
makedepends=('cmake' 'ninja' 'git' 'eigen' 'boost')
provides=('basalt-monado' 'basalt-monado-git')
conflicts=('basalt-monado' 'basalt-monado-git')
options=('!debug' '!lto')
source=('basalt::git+https://gitlab.freedesktop.org/mateosss/basalt.git#commit=df6e970c8da7636eb401a09e3317fbeaaf829b9a'
