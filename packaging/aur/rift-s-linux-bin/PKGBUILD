pkgname=rift-s-linux-bin
pkgver=28
pkgrel=1
pkgdesc='Oculus Rift S on Linux SteamVR: driver, Room Setup, Settings app and in-headset desktop (prebuilt)'
arch=('x86_64')
url='https://github.com/lbgos/rift-s-linux'
license=('BSL-1.0' 'MIT' 'BSD-2-Clause' 'BSD-3-Clause' 'OFL-1.1' 'Apache-2.0' 'CC-BY-4.0'
         'CC0-1.0' 'Unlicense' 'Zlib' 'ISC' 'MPL-2.0' 'Unicode-3.0'
         'Apache-2.0 WITH LLVM-exception' 'LicenseRef-Khronos-Free-Use-License-for-Software-and-Documentation')
depends=('glibc' 'libgcc' 'libstdc++' 'libusb' 'opencv' 'onetbb' 'fmt' 'sdl2' 'libglvnd'
         'vulkan-icd-loader' 'libx11' 'libxcb' 'libxrandr' 'wayland' 'libdrm'
         'systemd-libs' 'libpipewire' 'cjson' 'python' 'libcap' 'systemd' 'util-linux' 'procps-ng'
         'coreutils' 'tar' 'webkit2gtk-4.1' 'gtk3' 'cairo' 'libsoup3' 'gdk-pixbuf2' 'glib2' 'dbus'
         'hicolor-icon-theme')
optdepends=('steam: install and run SteamVR from the Steam library (native installation)'
            'kwin: in-headset Desktop overlay and minimized VR View preview source'
            'kconfig: write the VR View window rule (kwriteconfig6)'
            'qt6-tools: apply the VR View window rule (qdbus6)')
# Bundles the patched Basalt tracking library that rift-s-linux-git takes from basalt-monado-rifts.
provides=('rift-s-linux' 'monado' 'rifts-settings' 'basalt-monado-rifts' 'basalt-monado')
conflicts=('rift-s-linux' 'monado' 'monado-git' 'rifts-settings' 'basalt-monado-rifts' 'basalt-monado'
           'basalt-monado-git' 'monado-rifts-git')
install=rift-s-linux.install
options=('!strip' '!debug')
source=("https://github.com/lbgos/rift-s-linux/releases/download/r$pkgver/rift-s-linux-r$pkgver-x86_64.tar.zst")
sha256sums=('c85f34d53fca8dbf13e13914efef32e1dea580b7d266412d2f0e817f93b6fd59')

package() {
  cp -a usr "$pkgdir/"
  mv "$pkgdir/usr/share/licenses/rift-s-linux" "$pkgdir/usr/share/licenses/$pkgname"
}
