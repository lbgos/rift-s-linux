{
  "action_manifest_version": 0,
  "app_key": "openvr.component.vrcompositor",
  "controller_type": "monado_oculus_touch",
  "category": "steamvr_input",
  "name": "Monado Oculus Touch compositor",
  "description": "Dashboard and native playspace setup for Oculus Touch.",
  "bindings": {
    "/actions/system": {
      "sources": [
        {
          "path": "/user/hand/left/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/system/in/ToggleDashboard"
            }
          }
        }
      ]
    },
    "/actions/lasermouse": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/LeftClick"
            }
          },
          "parameters": {
            "click_activate_threshold": "0.65",
            "click_deactivate_threshold": "0.6"
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/LockMousePosition"
            }
          },
          "parameters": {
            "click_activate_threshold": "0.1",
            "click_deactivate_threshold": "0.05",
            "haptic_amplitude": "0"
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/Home"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/Back"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/lasermouse/in/TrackpadValue"
            },
            "touch": {
              "output": "/actions/lasermouse/in/TrackpadTouch"
            },
            "click": {
              "output": "/actions/lasermouse/in/RightClick"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/LeftClick"
            }
          },
          "parameters": {
            "click_activate_threshold": "0.65",
            "click_deactivate_threshold": "0.6"
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/LockMousePosition"
            }
          },
          "parameters": {
            "click_activate_threshold": "0.1",
            "click_deactivate_threshold": "0.05",
            "haptic_amplitude": "0"
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/Home"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse/in/Back"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/lasermouse/in/TrackpadValue"
            },
            "touch": {
              "output": "/actions/lasermouse/in/TrackpadTouch"
            },
            "click": {
              "output": "/actions/lasermouse/in/RightClick"
            }
          }
        }
      ],
      "poses": [
        {
          "path": "/user/hand/left/pose/tip",
          "output": "/actions/lasermouse/in/Pointer"
        },
        {
          "path": "/user/hand/right/pose/tip",
          "output": "/actions/lasermouse/in/Pointer"
        }
      ],
      "haptics": [
        {
          "path": "/user/hand/left/output/haptic",
          "output": "/actions/lasermouse/out/Haptic"
        },
        {
          "path": "/user/hand/right/output/haptic",
          "output": "/actions/lasermouse/out/Haptic"
        }
      ]
    },
    "/actions/roomsetup": {
      "sources": [
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/roomsetup/in/Accept"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/roomsetup/in/Back"
            }
          }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/roomsetup/in/FloorFineAdjust"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/roomsetup/in/Accept"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/roomsetup/in/Back"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/roomsetup/in/FloorFineAdjust"
            }
          }
        }
      ]
    },
    "/actions/scroll_smooth": {
      "sources": [
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/scroll_smooth/in/Scroll"
            }
          }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/scroll_smooth/in/Scroll"
            }
          }
        }
      ]
    },
    "/actions/lasermouse_secondary": {
      "sources": [
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse_secondary/in/SwitchLaserHand"
            }
          },
          "parameters": {
            "click_activate_threshold": "0.05",
            "click_deactivate_threshold": "0.02",
            "haptic_amplitude": "0"
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/lasermouse_secondary/in/SwitchLaserHand"
            }
          },
          "parameters": {
            "click_activate_threshold": "0.05",
            "click_deactivate_threshold": "0.02",
            "haptic_amplitude": "0"
          }
        }
      ]
    }
  }
}
