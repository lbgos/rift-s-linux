#!/usr/bin/env python3
"""Register the installed Rift S driver using SteamVR's own path registry tool.

`rifts-setup update` installs the latest GitHub release for the current install type.
`rifts-setup triage` writes machine facts for a support session and starts the user's
coding agent with the triage playbook (.github/triage/PLAYBOOK.md)."""
import argparse
import ctypes
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import select
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request

DRIVER = Path('@CMAKE_INSTALL_FULL_DATADIR@/steamvr-monado')
DESKTOP = Path('@CMAKE_INSTALL_FULL_BINDIR@/rifts-desktop')
PLAYBOOK = Path('@CMAKE_INSTALL_FULL_DATADIR@/rift-s-linux/triage/PLAYBOOK.md')
PLAYBOOK_URL = 'https://raw.githubusercontent.com/lbgos/rift-s-linux/main/.github/triage/PLAYBOOK.md'
AGENTS = ['claude', 'codex', 'gemini', 'opencode']
LATEST_RELEASE = 'https://api.github.com/repos/lbgos/rift-s-linux/releases/latest'
STEAMVR_APP = '250820'
# Steam starts SteamVR inside the Steam Linux Runtime container, which cannot see the
# host's /usr: a system-wide driver and its libraries would be missing. vrmonitor.sh
# starts SteamVR on the host instead. The universal build installs into the home
# directory, which the container shares, and needs no launch option.
LAUNCH_SUFFIX = '/bin/vrmonitor.sh %command%'
LAUNCH_PATH = ['UserLocalConfigStore', 'Software', 'Valve', 'Steam', 'apps', STEAMVR_APP]


def read_registry(path):
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def steam_roots(home):
    roots = [home / '.local/share/Steam', home / '.steam/steam', home / '.steam/root']
    result = []
    for root in roots:
        root = root.resolve()
        if root.is_dir() and root not in result:
            result.append(root)
    return result


def find_runtime(home, registry):
    roots = steam_roots(home)
    libraries = list(roots)
    for root in roots:
        folders = root / 'steamapps/libraryfolders.vdf'
        if folders.is_file():
            # Only library paths are needed; never read account or login files.
            for path in re.findall(r'"path"\s*"((?:\\.|[^"\\])*)"', folders.read_text()):
                library = Path(path.replace('\\\\', '\\').replace('\\"', '"'))
                if library not in libraries:
                    libraries.append(library)
    candidates = [Path(path) for path in registry.get('runtime', []) if isinstance(path, str)]
    candidates += [path / 'steamapps/common/SteamVR' for path in libraries]
    for runtime in candidates:
        tool = runtime / 'bin/linux64/vrpathreg'
        if tool.is_file() and os.access(tool, os.X_OK):
            return tool, roots, libraries
    return None, roots, libraries


def pathreg(tool, *arguments):
    # Native vrpathreg can report paths. Do not copy those or subprocess environment to logs.
    result = subprocess.run([str(tool), *arguments], stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, timeout=20)
    if result.returncode:
        raise RuntimeError('SteamVR driver registration failed; will retry.')


def register(home, registry_path, uninstall=False):
    registry = read_registry(registry_path)
    tool, roots, libraries = find_runtime(home, registry)
    if tool is None:
        return False, roots, libraries, None
    runtime = tool.parents[2]
    drivers = registry.get('external_drivers') or []
    if uninstall:
        if str(DRIVER) in drivers:
            pathreg(tool, 'removedriver', str(DRIVER))
        return True, roots, libraries, host_launch(roots, runtime, uninstall=True)
    if not (DRIVER / 'driver.vrdrivermanifest').is_file():
        raise RuntimeError('Installed Rift S driver manifest is missing.')
    if str(DRIVER) not in drivers:
        # Bootstrap only missing native paths. Existing runtime/config/log paths remain intact.
        if not registry.get('runtime'):
            pathreg(tool, 'setthis')
        root = roots[0] if roots else home / '.local/share/Steam'
        if not registry.get('config'):
            pathreg(tool, 'setconfig', str(root / 'config'))
        if not registry.get('log'):
            pathreg(tool, 'setlog', str(root / 'logs'))
        pathreg(tool, 'adddriver', str(DRIVER))
    # A home install drops the option a former system-wide install may have set.
    return True, roots, libraries, host_launch(roots, runtime, uninstall=home in DRIVER.parents)


def vdf_tokens(text):
    """Return (kind, start, end, value) for the quoted strings and braces of Steam KeyValues text."""
    tokens, i = [], 0
    while i < len(text):
        if text[i] == '"':
            j, value = i + 1, []
            while j < len(text) and text[j] != '"':
                if text[j] == '\\' and j + 1 < len(text):
                    j += 1
                value.append(text[j])
                j += 1
            if j >= len(text):
                raise ValueError('unterminated string')
            tokens.append(('str', i, j + 1, ''.join(value)))
            i = j + 1
        elif text[i] in '{}':
            tokens.append((text[i], i, i + 1, text[i]))
            i += 1
        elif text.startswith('//', i):
            end = text.find('\n', i)
            i = len(text) if end < 0 else end
        else:
            i += 1
    return tokens


def vdf_block(tokens, i=0, close=None):
    """Parse items into {'items': [(key, value_token | block)], 'close': offset of the closing brace}."""
    items = []
    while i < len(tokens):
        kind, start, _, key = tokens[i]
        if kind == '}':
            return {'items': items, 'close': start}, i + 1
        if kind != 'str' or i + 1 >= len(tokens):
            raise ValueError('expected key')
        if tokens[i + 1][0] == 'str':
            items.append((key, tokens[i + 1]))
            i += 2
        elif tokens[i + 1][0] == '{':
            child, i = vdf_block(tokens, i + 2)
            items.append((key, child))
        else:
            raise ValueError('expected value')
    if close is None:
        raise ValueError('unterminated block')
    return {'items': items, 'close': close}, i


def vdf_quote(value):
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"') + '"'


def with_launch_options(text, value):
    """Return text with SteamVR's LaunchOptions set to value (None removes ours), or None if the
    user has custom options. Only the one line changes, so the rest of Steam's file stays byte-identical."""
    block, _ = vdf_block(vdf_tokens(text), close=len(text))
    for depth, key in enumerate(LAUNCH_PATH):
        child = next((v for k, v in block['items'] if k.lower() == key.lower() and isinstance(v, dict)), None)
        if child is None:
            if value is None:
                return text
            # Insert the missing blocks before this block's closing brace, one level deeper.
            at = text.rfind('\n', 0, block['close']) + 1
            indent = '\t' * depth
            lines = []
            for level, missing in enumerate(LAUNCH_PATH[depth:]):
                pad = indent + '\t' * level
                lines += [f'{pad}{vdf_quote(missing)}\n', f'{pad}{{\n']
            pad = indent + '\t' * (len(LAUNCH_PATH) - depth)
            lines.append(f'{pad}"LaunchOptions"\t\t{vdf_quote(value)}\n')
            lines += [f'{indent}{chr(9) * level}}}\n' for level in reversed(range(len(LAUNCH_PATH) - depth))]
            return text[:at] + ''.join(lines) + text[at:]
        block = child
    current = next((v for k, v in block['items'] if k.lower() == 'launchoptions' and isinstance(v, tuple)), None)
    ours = current is not None and current[3].replace('"', '').endswith(LAUNCH_SUFFIX)
    if current is not None and current[3].strip() and not ours:
        return None
    if value is None:
        if not ours:
            return text
        # Drop our whole line, keeping Steam's own entries.
        start = text.rfind('\n', 0, current[1]) + 1
        end = text.find('\n', current[2])
        return text[:start] + text[end + 1 if end >= 0 else len(text):]
    if current is not None:
        return text[:current[1]] + vdf_quote(value) + text[current[2]:]
    at = text.rfind('\n', 0, block['close']) + 1
    pad = '\t' * len(LAUNCH_PATH)
    return text[:at] + f'{pad}"LaunchOptions"\t\t{vdf_quote(value)}\n' + text[at:]


def user_process(name):
    # Only comm and ownership, never process arguments or environments.
    for entry in Path('/proc').iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid == os.getuid() and (entry / 'comm').read_text().strip() == name:
                return int(entry.name)
        except (OSError, ProcessLookupError):
            pass
    return None


def host_launch(roots, runtime, uninstall=False):
    """Set (or on uninstall remove) the SteamVR launch option that keeps SteamVR on the host.
    Steam rewrites localconfig.vdf on exit, so it is edited only while Steam is closed.
    Returns a notice for the journal when the option cannot be applied yet."""
    command = str(runtime) + LAUNCH_SUFFIX
    if any(c.isspace() for c in str(runtime)):
        command = vdf_quote(str(runtime) + LAUNCH_SUFFIX[:-len(' %command%')]) + ' %command%'
    configs = sorted({path.resolve() for root in roots for path in root.glob('userdata/*/config/localconfig.vdf')})
    if user_process('steam'):
        if uninstall:
            # A leftover vrmonitor.sh option still starts SteamVR normally.
            return None
        pending = []
        for config in configs:
            try:
                text = config.read_text()
                if with_launch_options(text, None if uninstall else command) not in (text, None):
                    pending.append(config)
            except (OSError, ValueError):
                pass
        if pending:
            return 'Restart Steam once so SteamVR starts with the Rift S driver.'
        return None
    notice = None
    for config in configs:
        try:
            text = config.read_text()
            updated = with_launch_options(text, None if uninstall else command)
        except (OSError, ValueError):
            continue
        if updated is None:
            if not uninstall:
                notice = f'SteamVR has custom launch options. Add {command} to start it with the Rift S driver.'
            continue
        if updated == text:
            continue
        temporary = config.with_name(config.name + '.rifts-tmp')
        temporary.write_text(updated)
        os.chmod(temporary, config.stat().st_mode & 0o777)
        os.replace(temporary, config)
    return notice


def launch_desktop():
    # The client registers its manifest and preserves the user's autolaunch choice.
    # It also locks out duplicates when SteamVR has already started it.
    command = [str(DESKTOP), '--autolaunch']
    # Run it in its own unit: this service's memory limit only covers the watcher.
    if shutil.which('systemd-run'):
        subprocess.run(['systemd-run', '--user', '--quiet', '--collect', '--', *command],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
    else:
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


class DirectoryEvents:
    def __init__(self):
        self.libc = ctypes.CDLL(None, use_errno=True)
        self.libc.inotify_init1.argtypes = [ctypes.c_int]
        self.libc.inotify_add_watch.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
        self.fd = self.libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
        self.watches = set()

    def watch(self, directories):
        if self.fd < 0:
            return
        for directory in directories:
            directory = directory.resolve()
            while not directory.is_dir() and directory != directory.parent:
                directory = directory.parent
            # Re-add every pass: the kernel drops watches on moved or deleted
            # directories (IN_IGNORED), which wait() drains unread. Skipping
            # known paths here would leave watch mode deaf after a Steam
            # reinstall until the service restarts.
            mask = 0x100 | 0x80 | 0x8 | 0x400 | 0x800
            if self.libc.inotify_add_watch(self.fd, os.fsencode(directory), mask) >= 0:
                self.watches.add(directory)

    def wait(self):
        if self.fd < 0:
            time.sleep(2)
        elif select.select([self.fd], [], [], 2)[0]:
            try:
                os.read(self.fd, 65536)
            except BlockingIOError:
                pass
            time.sleep(0.1)


def release_ref(package, version):
    """The git ref an installed package was built from: `r31` for rift-s-linux-bin 31-1,
    the commit for a -git pkgver such as 25.1.0.r8702.gd82b8cbda. None when unknown."""
    if package == 'rift-s-linux-bin':
        return 'r' + version.split('-')[0]
    match = re.search(r'\.g([0-9a-f]{7,40})(?:-\d+)?$', version)
    return match.group(1) if package == 'rift-s-linux-git' and match else None


def install_facts():
    """Install type, prefix, version and source ref of this driver, keyed for the triage context."""
    prefix = DRIVER.parent.parent
    version_file = prefix / 'version'
    if version_file.is_file():
        version = version_file.read_text().strip()
        return {'Install type': 'universal build', 'Prefix': prefix, 'Version': version, 'Source ref': version}
    owner = subprocess.run(['pacman', '-Qqo', str(DRIVER)], capture_output=True, text=True) \
        if shutil.which('pacman') and DRIVER.exists() else None
    if owner and owner.returncode == 0:
        package = owner.stdout.strip()
        version = subprocess.run(['pacman', '-Q', package], capture_output=True, text=True).stdout.split()[-1]
        return {'Install type': f'Arch package {package}', 'Prefix': prefix, 'Version': version,
                'Source ref': release_ref(package, version) or 'unknown'}
    return {'Install type': 'source build' if DRIVER.exists() else 'driver not found', 'Prefix': prefix,
            'Version': 'unknown', 'Source ref': 'unknown'}


def read_first_line(path):
    try:
        return path.read_text().splitlines()[0].strip()
    except (OSError, IndexError):
        return None


def gpu_facts():
    gpus = []
    for card in sorted(Path('/sys/class/drm').glob('card[0-9]*')):
        device = card / 'device'
        if '-' in card.name or not (device / 'vendor').exists():
            continue
        driver = os.path.basename(os.readlink(device / 'driver')) if (device / 'driver').exists() else '?'
        gpus.append(f'{card.name}: {read_first_line(device / "vendor")}:{read_first_line(device / "device")} {driver}')
    nvidia = read_first_line(Path('/proc/driver/nvidia/version'))
    return gpus + ([nvidia] if nvidia else [])


def headset_facts():
    # Product names and link speed only; serial numbers stay out of the context file.
    found = []
    for device in sorted(Path('/sys/bus/usb/devices').glob('*')):
        if read_first_line(device / 'idVendor') == '2833':
            found.append(f'{device.name}: 2833:{read_first_line(device / "idProduct")} '
                         f'{read_first_line(device / "product") or ""} {read_first_line(device / "speed") or "?"} Mb/s')
    return found or ['no Oculus USB device connected']


def steamvr_versions(roots):
    # vrserver.txt starts each session with "vrserver <version> startup".
    for root in roots:
        try:
            with (root / 'logs/vrserver.txt').open(errors='replace') as log:
                for line in log:
                    if match := re.search(r'vrserver (\S+) startup', line):
                        yield match.group(1)
                        break
        except OSError:
            pass


def chaperone_universes(roots):
    # Universe IDs only; the calibration itself stays in the file.
    for root in roots:
        try:
            data = json.loads((root / 'config/chaperone_info.vrchap').read_text())
            yield ', '.join(str(u.get('universeID')) for u in data.get('universes', [])) or 'none'
        except FileNotFoundError:
            yield 'no chaperone_info.vrchap'
        except (OSError, ValueError, AttributeError):
            yield 'unreadable chaperone_info.vrchap'


def steamvr_driver_status(roots):
    # Inspect only our safe-mode flag, not unrelated Steam account settings.
    for root in roots:
        path = root / 'config/steamvr.vrsettings'
        try:
            data = json.loads(path.read_text())
            blocked = data.get('driver_monado', {}).get('blocked_by_safe_mode')
            if blocked is True:
                yield f'{path}: driver_monado.blocked_by_safe_mode=true. After fixing USB enumeration, ' \
                      're-enable the Monado add-on in SteamVR Settings > Startup/Shutdown > Manage Add-ons.'
            elif blocked is False:
                yield f'{path}: Monado add-on is not blocked by safe mode'
        except FileNotFoundError:
            pass
        except (OSError, ValueError, AttributeError):
            yield f'{path}: unable to inspect Monado safe-mode status'


def triage_context(home, registry_path, state, directory):
    os_release = dict(re.findall(r'^(\w+)="?([^"\n]*)"?$', Path('/etc/os-release').read_text(), re.M)) \
        if Path('/etc/os-release').is_file() else {}
    registry = read_registry(registry_path)
    tool, roots, _ = find_runtime(home, registry)
    runtime = tool.parents[2] if tool else None
    lines = ['# rift-s-linux triage context', '',
             f'Created {time.strftime("%Y-%m-%d %H:%M:%S %z (%Z)")}. Logs use this local time zone.', '']

    def section(title, rows):
        lines.extend([f'## {title}', ''])
        lines.extend(f'- {row[0]}: {row[1]}' if isinstance(row, tuple) else f'- {row}' for row in rows)
        lines.append('')

    section('rift-s-linux', [*install_facts().items(),
        ('Driver directory', DRIVER), ('Installed playbook', PLAYBOOK),
        ('Source cache directory', state / 'triage/source'),
        ('Registration service', subprocess.run(
            ['systemctl', '--user', 'is-active', 'rifts-steamvr-registration.service'],
            capture_output=True, text=True).stdout.strip() or 'unknown')])
    section('System', [
        ('OS', os_release.get('PRETTY_NAME', 'unknown')), ('Kernel', os.uname().release),
        ('Desktop', f'{os.environ.get("XDG_CURRENT_DESKTOP", "?")} {os.environ.get("XDG_SESSION_TYPE", "?")}'),
        *gpu_facts()])
    section('Headset USB', headset_facts())
    section('Steam and SteamVR', [
        *(('Steam root', root) for root in roots),
        ('Flatpak Steam data', home / '.var/app/com.valvesoftware.Steam'
         if (home / '.var/app/com.valvesoftware.Steam').is_dir() else 'absent'),
        ('Snap Steam data', home / 'snap/steam' if (home / 'snap/steam').is_dir() else 'absent'),
        ('SteamVR runtime', runtime or 'not found'),
        *(('SteamVR version', version) for version in steamvr_versions(roots)),
        *(('Chaperone universes', universes) for universes in chaperone_universes(roots)),
        *(('Monado add-on', status) for status in steamvr_driver_status(roots)),
        ('OpenVR registry', registry_path),
        *(('Registered driver', path) for path in registry.get('external_drivers') or [])])
    section('Running processes', [
        f'{name}: {"pid " + str(pid) if (pid := user_process(name)) else "not running"}'
        for name in ['steam', 'vrmonitor', 'vrserver', 'vrcompositor', 'rifts-settings', 'rifts-desktop']])
    logs = [log for root in roots for log in sorted((root / 'logs').glob('*'))
            if log.name.startswith(('vrserver', 'vrcompositor', 'vrclient_monado'))]
    section('Logs', [f'{log} ({time.strftime("%Y-%m-%d %H:%M", time.localtime(log.stat().st_mtime))})'
                     for log in logs] + [
        'journalctl --user -b -u rifts-steamvr-registration.service', 'journalctl -k -b'])
    section('State and configuration', [
        state, Path(os.environ.get('XDG_CONFIG_HOME', home / '.config')) / 'monado',
        *(root / 'config' for root in roots)])
    section('Never read', [
        *(root / name for root in roots for name in ['config/config.vdf', 'config/loginusers.vdf', 'ssfn*']),
        'Steam userdata/ beyond the SteamVR launch options'])
    (directory / 'context.md').write_text('\n'.join(lines))


def release_asset(install_type, tag, names):
    """The release asset that updates this install type, or None when it is built locally."""
    if install_type == 'universal build':
        wanted = re.compile(rf'rift-s-linux-{re.escape(tag)}-x86_64\.tar\.xz')
    elif install_type == 'Arch package rift-s-linux-bin':
        wanted = re.compile(rf'rift-s-linux-bin-{re.escape(tag[1:])}-\d+-x86_64\.pkg\.tar\.zst')
    else:
        return None
    return next((name for name in names if wanted.fullmatch(name)), None)


def download(url, path):
    request = urllib.request.Request(url, headers={'User-Agent': 'rifts-setup'})
    with urllib.request.urlopen(request, timeout=60) as response, open(path, 'wb') as out:
        shutil.copyfileobj(response, out, 1 << 20)


def update(check_only):
    facts = install_facts()
    install_type, installed = facts['Install type'], facts['Source ref']
    request = urllib.request.Request(LATEST_RELEASE, headers={'User-Agent': 'rifts-setup'})
    with urllib.request.urlopen(request, timeout=30) as response:
        release = json.load(response)
    tag = release['tag_name']
    assets = {asset['name']: asset['browser_download_url'] for asset in release['assets']}
    if installed == tag:
        print(f'rift-s-linux {tag} is up to date.')
        return
    asset = release_asset(install_type, tag, assets)
    if not asset:
        print(f'{tag} is the latest release; this is a {install_type} ({installed}).')
        if install_type == 'Arch package rift-s-linux-git':
            print('Rebuild it with makepkg -si in packaging/aur/rift-s-linux-git of a fresh clone.')
        else:
            print('Pull main and rebuild as described in the README.')
        return
    print(f'{tag} is available (installed: {installed}).')
    if check_only:
        return
    running = [name for name in ['vrmonitor', 'vrserver', 'rifts-settings'] if user_process(name)]
    if running:
        raise SystemExit(f'Close SteamVR and Settings first (running: {", ".join(running)}).')
    with tempfile.TemporaryDirectory(prefix='rifts-update-') as directory:
        directory = Path(directory)
        print(f'Downloading {asset}', flush=True)
        download(assets[asset], directory / asset)
        download(assets['SHA256SUMS'], directory / 'SHA256SUMS')
        sums = dict(reversed(line.split()) for line in (directory / 'SHA256SUMS').read_text().splitlines() if line)
        digest = hashlib.sha256()
        with open(directory / asset, 'rb') as payload:
            while chunk := payload.read(1 << 20):
                digest.update(chunk)
        digest = digest.hexdigest()
        if sums.get(asset) != digest:
            raise SystemExit(f'{asset} does not match SHA256SUMS; nothing was installed.')
        if install_type == 'universal build':
            subprocess.run(['tar', '-xf', asset], cwd=directory, check=True)
            subprocess.run([str(directory / asset.removesuffix('.tar.xz') / 'install.sh')], check=True)
        else:
            subprocess.run(['sudo', 'pacman', '-U', str(directory / asset)], check=True)
    print(f'Updated to {tag}. Start SteamVR from Steam.')


def triage(home, registry_path, state, agent):
    directory = state / 'triage' / time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())
    directory.mkdir(parents=True, mode=0o700)
    (state / 'triage/source').mkdir(exist_ok=True)
    triage_context(home, registry_path, state, directory)
    playbook = PLAYBOOK.read_text() if PLAYBOOK.is_file() else f'Fetch the playbook from {PLAYBOOK_URL}.\n'
    (directory / 'prompt.md').write_text(
        'A rift-s-linux user has a problem with their setup and started this session with '
        '`rifts-setup triage`.\n\nMachine facts are in the triage context file:\n\n'
        f'    {directory / "context.md"}\n\nFollow the playbook below, starting by asking the user '
        'what went wrong.\n\n---\n\n' + playbook)
    command = agent or next((name for name in AGENTS if shutil.which(name)), None)
    instruction = f'Read {directory / "prompt.md"} and follow it.'
    if not command:
        print(f'No coding agent found ({", ".join(AGENTS)}). Start one and tell it:\n  {instruction}')
        return
    print(f'Starting {command}. Triage files: {directory}', flush=True)
    os.chdir(directory)
    os.execvp(command, [command, instruction])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['install', 'uninstall', 'watch', 'update', 'triage'], nargs='?', default='install')
    parser.add_argument('--check', action='store_true', help='update: only report whether a newer release exists')
    parser.add_argument('--agent', help='coding agent command for triage (default: first of %s found)' % ', '.join(AGENTS))
    args = parser.parse_args()
    if os.geteuid() == 0:
        parser.error('Run in the Steam user session.')
    home = Path.home()
    config = Path(os.environ.get('XDG_CONFIG_HOME', home / '.config'))
    registry_path = Path(os.environ.get('VR_PATHREG_OVERRIDE', config / 'openvr/openvrpaths.vrpath'))
    state = Path(os.environ.get('XDG_STATE_HOME', home / '.local/state')) / 'monado-rifts'
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    if args.action == 'triage':
        triage(home, registry_path, state, args.agent)
        return
    if args.action == 'update':
        update(args.check)
        return
    events = DirectoryEvents()
    last_error = None
    last_desktop_server = None
    last_notice = None
    with (state / 'registration.lock').open('w') as lock:
        while True:
            with_lock = False
            try:
                fcntl.flock(lock, fcntl.LOCK_EX)
                with_lock = True
                done, roots, libraries, notice = register(home, registry_path, args.action == 'uninstall')
                last_error = None
                if notice and notice != last_notice:
                    print(notice, file=sys.stderr, flush=True)
                last_notice = notice
            except (OSError, RuntimeError, subprocess.TimeoutExpired) as error:
                if args.action != 'watch':
                    raise SystemExit(str(error))
                if last_error != str(error):
                    print(str(error), file=sys.stderr, flush=True)
                    last_error = str(error)
                roots, libraries = steam_roots(home), []
                done = False
            finally:
                if with_lock:
                    fcntl.flock(lock, fcntl.LOCK_UN)
            if done and DESKTOP.is_file():
                server = user_process('vrserver')
                if args.action == 'uninstall':
                    if server:
                        subprocess.run([str(DESKTOP), '--unregister'], stdout=subprocess.DEVNULL,
                                       stderr=subprocess.DEVNULL, timeout=20)
                elif server and server != last_desktop_server:
                    launch_desktop()
                    last_desktop_server = server
                elif not server:
                    last_desktop_server = None
            if args.action != 'watch':
                print('Rift S registered.' if done else 'Rift S registration will complete when SteamVR is installed.')
                return
            directories = [config / 'openvr', home / '.local/share/Steam', home / '.steam']
            for root in roots:
                # Steam writes localconfig.vdf on exit; that is when the launch option can be set.
                directories.extend([root, root / 'steamapps', root / 'userdata'])
                directories.extend(root.glob('userdata/*/config'))
            for library in libraries:
                runtime = library / 'steamapps/common/SteamVR'
                directories.extend([library, library / 'steamapps', library / 'steamapps/common',
                                    runtime, runtime / 'bin', runtime / 'bin/linux64'])
            events.watch(directories)
            events.wait()


if __name__ == '__main__':
    main()
